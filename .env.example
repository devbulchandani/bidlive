# Nexconn application credentials.
#
# Create a free app at https://console.nexconn.ai → copy the DEVELOPMENT App Key
# and App Secret. Without these the app still runs end-to-end on a local event
# bus, and the UI says "Nexconn: local bus" instead of pretending.
#
# NEVER prefix the secret with NEXT_PUBLIC_ — it would ship to the browser.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=

# Public app key for the browser SDK (safe to expose — it identifies the app,
# it does not authorise anything).
NEXT_PUBLIC_NEXCONN_APP_KEY=

# Data centre. Run `npm run check:nexconn` to find which one your app uses.
#   Singapore            https://api.sg-light-api.com      areaCode 2
#   Singapore enterprise https://api.sg-b-light-api.com    areaCode 4
#   North America        https://api.us-light-api.com      areaCode 3
#   Saudi Arabia         https://api.sau-light-api.com     areaCode 5
#   China (Beijing)      https://api.rong-api.com          areaCode 1
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_API_BACKUP=https://api-b.sg-light-api.com
NEXCONN_AREA_CODE=2
NEXT_PUBLIC_NEXCONN_AREA_CODE=2

# Set to 1 once the message callback is configured in the Nexconn console and
# this app is publicly reachable — enables pre-delivery bid validation.
NEXCONN_CALLBACK_ENFORCE=0

# Narration for `npm run video`. Falls back to macOS `say` when unset.
# Get a key at https://app.gnani.ai/voice — the TTS endpoint is
# POST https://api.vachana.ai/api/v1/tts/inference with an X-API-Key-ID header.
GNANI_API_KEY=
GNANI_VOICE=Arko
GNANI_MODEL=timbre-v3.0
GNANI_LANGUAGE=en-IN
