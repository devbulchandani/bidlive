# Nexconn application credentials.
#
# Create a free app at https://console.nexconn.ai → copy the DEVELOPMENT App Key
# and App Secret. Without these the app still runs end-to-end on a local event
# bus, and the UI says "Nexconn: local bus" instead of pretending.
#
# NEVER prefix the secret with NEXT_PUBLIC_ — it would ship to the browser.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=

# Public app key for the browser SDK (safe to expose — it identifies the app,
# it does not authorise anything).
NEXT_PUBLIC_NEXCONN_APP_KEY=

# Server API host. SG data centre by default.
NEXCONN_API_BASE=https://api.sg.rongcloud.cn
NEXCONN_AREA_CODE=1

# Set to 1 once the message callback is configured in the Nexconn console and
# this app is publicly reachable — enables pre-delivery bid validation.
NEXCONN_CALLBACK_ENFORCE=0
